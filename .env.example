# =============================================================================
# Pernod Ricard RAG Chatbot — environment template
# Copy to .env and fill in secrets. Never commit .env.
# =============================================================================

# --- Application ---
APP_NAME=pernod-ricard-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Admin token for ingestion / re-index endpoints (required in production)
ADMIN_API_TOKEN=change-me-to-a-long-random-token

# --- Grok (X.AI, OpenAI-compatible) ---
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-3
GROK_TIMEOUT_SECONDS=60
GROK_MAX_TOKENS=1024
GROK_TEMPERATURE=0.2

# --- OpenAI (optional embedding fallback; primary embeddings are BAAI/bge-m3) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# --- Embeddings (primary: local BAAI/bge-m3 via sentence-transformers) ---
EMBEDDING_PROVIDER=baai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=5
EMBEDDING_DEVICE=cpu

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_COLLECTION=pernod_ricard_chunks
QDRANT_TIMEOUT_SECONDS=30

# --- Retrieval ---
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
DENSE_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=8
RRF_K=60
MMR_LAMBDA=0.7
MMR_CANDIDATES=30

# --- BM25 ---
BM25_INDEX_PATH=data/indexes/bm25.pkl
BM25_K1=1.5
BM25_B=0.75

# --- Chunking ---
CHUNK_MAX_CHARS=1800
CHUNK_MIN_CHARS=200
CHUNK_OVERLAP_CHARS=220
SEMANTIC_SIMILARITY_THRESHOLD=0.55

# --- Crawler ---
CRAWL_MAX_PAGES=40
CRAWL_MAX_DEPTH=2
CRAWL_REQUEST_TIMEOUT_SECONDS=30
CRAWL_MAX_RETRIES=3
CRAWL_RETRY_BACKOFF_SECONDS=1.5
CRAWL_USER_AGENT=PernodRicardRAGBot/1.0 (+https://www.pernod-ricard.com)
CRAWL_RATE_LIMIT_SECONDS=1.0
CRAWL_USE_SYNTHETIC_FALLBACK=true
SYNTHETIC_DATA_DIR=data/synthetic

# --- Age gate ---
AGE_GATE_ENABLED=true
MINIMUM_LEGAL_DRINKING_AGE=18
AGE_GATE_STRICT_SERVER_ENFORCEMENT=true
AGE_VERIFICATION_HEADER=X-Age-Verified

# --- Responsible drinking / medical redirect URLs ---
DRINKAWARE_URL=https://www.drinkaware.co.uk
NIAAA_URL=https://www.niaaa.nih.gov

# --- Frontend ---
BACKEND_URL=http://127.0.0.1:8000

# --- RAGAS ---
RAGAS_FAITHFULNESS_THRESHOLD=0.60
RAGAS_CONTEXT_PRECISION_THRESHOLD=0.60
RAGAS_ANSWER_RELEVANCY_THRESHOLD=0.60
RAGAS_OUTPUT_DIR=data/indexes
